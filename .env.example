# Kopieer naar .env en vul in. .env gaat NIET naar GitHub.

# Fictieve bedrijfsnaam in alle berichten aan de klant
BEDRIJFSNAAM=Installatiebedrijf De Vries

# Simulatie per dienst: true = nagebootst, false = echt account
SIMULATIE_TELEFONIE=true
SIMULATIE_WHATSAPP=true
SIMULATIE_AGENDA=true

# US-3: storing uitlezen met Claude
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta testnummer) - zie docs/accounts.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_ONTVANGER=+316xxxxxxxx

# Twilio (US-1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMMER=

# Publiek adres voor webhooks (ngrok)
PUBLIEK_ADRES=

# Google Agenda (US-4)
GOOGLE_SERVICE_ACCOUNT_BESTAND=google-service-account.json
GOOGLE_AGENDA_ID=
